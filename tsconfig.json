{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "typeRoots": ["./src/@types"],
    "paths": {
      "@/*": ["./src/*"]
    },

    // Environment Settings
    "module": "commonjs",
    "target": "es6",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "removeComments": true
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules"]
}
